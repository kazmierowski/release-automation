# Release Automation MCP Server Configuration
# Copy this file to .env and fill in your values

# ===== ENVIRONMENT CONFIGURATION =====
# Default deployment environment (Integration, UAT, UAT1, PROD)
DEFAULT_ENVIRONMENT=Integration
NODE_ENV=development

# ===== GIT PLATFORM CONFIGURATION =====
# Git platform provider (bitbucket, github, gitlab)
GIT_PLATFORM=bitbucket
GIT_BASE_URL=https://bitbucket.org
BITBUCKET_USERNAME=your-username
BITBUCKET_APP_PASSWORD=your-app-password

# ===== JENKINS CONFIGURATION =====
JENKINS_BASE_URL=https://jenkins.example.com
JENKINS_API_TOKEN=your-jenkins-token

# ===== JIRA CONFIGURATION =====
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-token

# ===== MICROSOFT TEAMS CONFIGURATION =====
TEAMS_TENANT_ID=your-tenant-id
TEAMS_CLIENT_ID=your-client-id
TEAMS_CLIENT_SECRET=your-client-secret
TEAMS_DEPLOYMENT_CHANNEL_ID=channel-id
TEAMS_TEAM_ID=team-id
TEAMS_RELEASE_TEAM_ID=release-team-id

# ===== AZURE KEY VAULT CONFIGURATION =====
AZURE_VAULT_URL=https://your-vault.vault.azure.net/
# Managed Identity is recommended - set this only for local development
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# AZURE_TENANT_ID=your-tenant-id

# ===== MCP SERVER CONFIGURATION =====
MCP_SERVER_PORT=3001
MCP_SERVER_HOST=0.0.0.0

# ===== DASHBOARD CONFIGURATION =====
DASHBOARD_URL=http://localhost:3000

# ===== N8N CONFIGURATION =====
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== PERFORMANCE CONFIGURATION =====
# Polling interval for PR approvals (milliseconds)
PR_APPROVAL_POLL_INTERVAL=120000
# Jenkins job poll interval (milliseconds)
JENKINS_POLL_INTERVAL=30000
# Dashboard update interval (milliseconds)
DASHBOARD_UPDATE_INTERVAL=10000
